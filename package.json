{
  "name": "amazon-connect-streams",
  "version": "2.30.3",
  "description": "Amazon Connect Streams Library",
  "engines": {
    "node": ">=12.0.0"
  },
  "directories": {
    "lib": "./release"
  },
  "files": [
    "/release",
    "/src/index.d.ts",
    "/NOTICE.txt",
    "/THIRD_PARTY.txt"
  ],
  "main": "release/connect-streams.js",
  "types": "src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amazon-connect/amazon-connect-streams.git"
  },
  "keywords": [
    "streams",
    "softphone",
    "ringtone",
    "connect"
  ],
  "scripts": {
    "release": "npm run lint-strict && npm run build-streams && npm run build-streams-test && npm run test-jest",
    "build-streams": "webpack --config ./webpack/connect-streams.config.js && webpack --config ./webpack/connect-streams-min.config.js",
    "lint-strict": "eslint --no-eslintrc --config .eslintrc.strict.json --ignore-path .eslintignore.strict --max-warnings=0 --ext .js src",
    "build-streams-test": "webpack --config ./webpack/connect-streams-test.config.js",
    "test-jest": "jest --config test/unit/jest.config.js",
    "clean": "rm -rf build/ node_modules build coverage .nyc_output package-lock.json"
  },
  "author": "Amazon Web Services",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/amazon-connect/amazon-connect-streams/issues"
  },
  "homepage": "https://github.com/amazon-connect/amazon-connect-streams#readme",
  "dependencies": {
    "@amazon-connect/activity": "1.0.12",
    "@amazon-connect/core": "1.0.12",
    "@amazon-connect/contact": "1.0.12",
    "@amazon-connect/voice": "1.0.12",
    "@amazon-connect/site": "1.0.12",
    "amazon-chime-sdk-js": "^3.29.0",
    "@amazon-connect/site-streams": "1.0.12"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.24.5",
    "@babel/preset-env": "^7.24.5",
    "@babel/preset-typescript": "^7.24.1",
    "@typescript-eslint/eslint-plugin": "^5.59.1",
    "@typescript-eslint/parser": "^5.59.1",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "babel-plugin-istanbul": "^6.1.1",
    "chai": "^4.3.7",
    "eslint": "^8.39.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^2.8.8",
    "proxyquire": "^2.1.3",
    "terser-webpack-plugin": "^5.3.10",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  }
}
